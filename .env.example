VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Demo/local password login + role switcher. Leave unset for DEV-only.
# MUST be false (or unset) in production — use real Supabase Auth users.
VITE_ALLOW_DEMO_AUTH=false

# COA OCR uses a built-in local model (Tesseract) by default — no API key required.
# Optional: set a key only if you want cloud vision to fill gaps after local OCR.
# AI_GATEWAY_API_KEY=
# OPENAI_API_KEY=
# COA_OCR_MODEL=openai/gpt-4o
